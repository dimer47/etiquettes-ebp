# Modèle de configuration locale pour fastlane — À COPIER en fastlane/.env
#
#   cp fastlane/.env.example fastlane/.env
#
# Le fichier fastlane/.env RÉEL n'est JAMAIS commité (voir .gitignore) : il contient
# des secrets liés à votre compte App Store Connect. Ce modèle, lui, ne contient
# aucune valeur réelle et peut rester public.
#
# Ces variables ne servent QU'À la lane `upload_screenshots` (envoi des captures).
# La lane `screenshots` (génération locale seule) n'en a pas besoin.

# Clé API App Store Connect (App Store Connect → Utilisateurs et accès → Intégrations).
# Key ID de la clé (10 caractères).
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX

# Issuer ID (UUID affiché en haut de la page des clés API).
APP_STORE_CONNECT_API_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Chemin ABSOLU vers le fichier .p8 de la clé, stocké HORS du dépôt
# (par convention dans ~/.appstoreconnect/private_keys/).
APP_STORE_CONNECT_API_KEY_PATH=/Users/VOTRE_UTILISATEUR/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
